                },
                "parameters": {
                  "entityName": "ljr_contracts",
                  "recordId": "@items('Apply_to_each_expired_contract')?['ljr_contractid']",
                  "item": {
                    "statecode": 1,
                    "statuscode": 2
                  }
                }
              }
            }
          },
